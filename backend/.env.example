# ==============================================================================
# ODIN: MULTI-AGENT CONTRACT INTELLIGENCE NODE/EXPRESS BACKEND (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB / Mongoose)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/odin
USE_MEMORY_DB_FALLBACK=true

# ------------------------------------------------------------------------------
# 3. LLM PROVIDER PRIORITY CASCADE (Claude -> Groq -> Gemini -> OpenAI)
# ------------------------------------------------------------------------------
LLM_PROVIDER_ORDER=claude,groq,gemini,openai
LLM_TIMEOUT_SECONDS=15
LLM_TEMPERATURE=0.2

# --- Priority 1: Claude (Anthropic) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# --- Priority 2: Groq ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# --- Priority 3: Gemini (Google Generative AI) ---
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Priority 4: OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 4. WAR ROOM & DATASET CONFIGURATION
# ------------------------------------------------------------------------------
ODIN_DATA_DIR=../odin_data
DEFAULT_CLOCK_DATE=2027-01-15
BUSINESS_CALENDAR_HOLIDAYS=../odin_data/bundle/data/holidays.csv
PAYMENTS_LEDGER_FILE=../odin_data/bundle/data/payments_ledger.csv
